# Скопировать в keystore.properties (он в .gitignore) и подставить свои значения.
# Ключ создаётся один раз, теряется — теряется возможность обновлять приложение:
#   keytool -genkeypair -v -keystore keystore/upload-keystore.jks -storetype JKS \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10950 \
#     -dname "CN=shkaff upload, OU=app, O=shkaff, L=Unknown, ST=Unknown, C=RU"
storeFile=keystore/upload-keystore.jks
keyAlias=upload
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
